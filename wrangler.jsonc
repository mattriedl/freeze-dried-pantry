// Cloudflare Workers settings for freezedryclub.com: the Astro build (dist/) served
// straight from Cloudflare's network. GitHub Actions runs `npm run build` and then
// `wrangler deploy` on every push to main (.github/workflows/deploy-cloudflare.yml).
{
  "name": "freezedryclub",
  "account_id": "85d2ba69d7730294ed5758d25f277d23",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Pages live at /slug/ (Astro trailingSlash: 'always'); /slug redirects to /slug/.
    "html_handling": "auto-trailing-slash",
    // Unknown addresses get /404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  "workers_dev": true
}
