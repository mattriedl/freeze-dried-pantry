# Freeze Dry Club: rules shipped with the site (deployed on every push).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www -> apex (Cloudflare handles http -> https)
  RewriteCond %{HTTP_HOST} ^www\.freezedryclub\.com$ [NC]
  RewriteRule ^ https://freezedryclub.com%{REQUEST_URI} [R=301,L]
  # Pages live at /slug/ — add the trailing slash if it's missing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted assets never change: cache for a year
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/javascript image/svg+xml
</IfModule>
