# Response headers on Cloudflare Workers (replaces the caching/security part of .htaccess).
/*
  # no-transform: stops Cloudflare injecting its bot-detection script into pages
  # (antivirus programs such as Avast flag it as "HTML:Script-inf [Susp]").
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Fingerprinted assets never change: cache for a year.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform
